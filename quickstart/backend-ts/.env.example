PORT=8081
# Defaults to enabled outside production.
# API_DOCS_ENABLED=true

# Ledger API settings are required when initializing the ledger integration.
# Use the participant HTTP endpoint, not the gRPC port.
LEDGER_API_URL=http://localhost:3975
# Enable only for an intentionally unencrypted Ledger connection, such as LocalNet.
LEDGER_API_ALLOW_HTTP=true
# Use the Ledger API user ID created by onboarding.
LEDGER_API_USER_ID=app-provider-backend
# JWT generated by onboarding in shared-secret mode.
APP_PROVIDER_BACKEND_USER_TOKEN=replace-with-onboarding-token

# shared-secret uses the onboarding token above; oauth2 requests service tokens.
AUTH_MODE=shared-secret
# OAuth2 mode uses the existing Quickstart service client variables.
# AUTH_APP_PROVIDER_ISSUER_URL=http://localhost:8082/realms/AppProvider
# Browser login uses a separate public client.
# Public browser origin for OIDC callbacks (defaults to the demo UI and APP_PROVIDER_UI_PORT).
# OIDC_PUBLIC_ORIGIN=http://app-provider.localhost:3000
# AUTH_APP_PROVIDER_BACKEND_OIDC_CLIENT_ID=app-provider-backend-oidc
# AUTH_APP_PROVIDER_BACKEND_CLIENT_ID=app-provider-backend
# AUTH_APP_PROVIDER_BACKEND_SECRET=replace-with-service-client-secret
# Enable only for a local HTTP identity provider.
# LEDGER_OAUTH_ALLOW_HTTP=true

# Quickstart application settings.
APP_PROVIDER_PARTY=replace-with-app-provider-party-id

# PQS PostgreSQL database, using the same names as the Java backend.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=pqs-app-provider
POSTGRES_USERNAME=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password
# POSTGRES_POOL_MAX=10
# POSTGRES_CONNECTION_TIMEOUT_MS=5000
# POSTGRES_STATEMENT_TIMEOUT_MS=30000
