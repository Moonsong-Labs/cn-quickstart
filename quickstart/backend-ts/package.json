{
  "name": "@cn-quickstart/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@elysiajs/openapi": "1.4.15",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/bun": "1.3.3",
    "openapi-types": "12.1.3"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun build src/server.ts --target bun --outdir dist --sourcemap=external",
    "start:prod": "bun dist/server.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  }
}
