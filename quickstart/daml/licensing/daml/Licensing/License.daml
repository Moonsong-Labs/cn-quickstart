--
-- | A license contract for a CN application that allows the app provider
--   to charge a fee for renewing the license. The fee is collected using
--   the token standard. This license is not itself a token instrument.
module Licensing.License where

import DA.Time
import DA.Assert (assertWithinDeadline, assertDeadlineExceeded, (===))
import DA.Map qualified as Map
import DA.TextMap as TextMap

import Licensing.Util as Util (require)
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2
import Splice.Api.Token.AllocationRequestV2
import Splice.Api.Token.AllocationV2
import Splice.Api.Token.AllocationInstructionV2

data LicenseKey = LicenseKey with
    provider : Party
    user : Party
    uuid : Text
  deriving (Eq, Show)

data LicenseRenewalRequestKey = LicenseRenewalRequestKey with
    provider : Party
    user : Party
    requestId : Text
  deriving (Eq, Show)

-- | Parameters determining the license behavior.
data LicenseParams = LicenseParams
  with
    meta : Metadata -- ^ Machine-readable metadata for this license.
  deriving (Eq, Show)

-- | A license contract between an app provider and an app user to use the app.
template License
  with
    provider : Party -- ^ Party identifying the app provider
    user : Party -- ^ Party identifying the app user
    expiresAt : Time -- ^ When the license expires. The license is not valid after this time.
    uuid : Text -- ^ Provider-generated UUID, preserved across renewals.
    licenseNum : Int -- ^ Display number scoped to the originating app installation.
    params : LicenseParams
  where
    signatory provider, user
    ensure uuid /= ""

    key LicenseKey with provider; user; uuid : LicenseKey
    maintainer key.provider

    -- | Renews this license by collecting a fee from the user
    --   via the token standard. The actual settlement flow
    --   is defined by the corresponding LicenseRenewalRequest.
    nonconsuming choice License_Renew : ContractId LicenseRenewalRequest
      with
        requestId : Text
        licenseFeeInstrumentId : InstrumentId
        licenseFeeAmount : Decimal
        licenseExtensionDuration : RelTime
        requestedAt : Time
        settleBefore : Time
        description : Text
      controller provider
      do
        assertDeadlineExceeded "requestedAt" requestedAt
        assertWithinDeadline "settleBefore" settleBefore
        -- Request keys may repeat. Give each settlement its own ledger identifier.
        settlementReference <- create RenewalSettlementReference with provider
        archive settlementReference
        create LicenseRenewalRequest with
          settlementReference
          originalRequestCid = None
          requestId
          provider
          user
          uuid
          licenseNum
          licenseFeeAmount
          licenseFeeInstrumentId
          licenseExtensionDuration
          settleBefore
          requestedAt
          description

    -- | Used if a provider/user chooses to mark the license as expired
    --   once the time has actually passed.
    choice License_Expire : ()
      with
        actor : Party
        meta : Metadata
      controller actor
      do
        require "Actor is a signatory" (actor `elem` signatory this)
        assertDeadlineExceeded "expiresAt" expiresAt

-- | Its contract ID identifies the settlement even when the provider reuses a request ID.
template RenewalSettlementReference
  with provider : Party
  where signatory provider

-- | A request to renew a license. This is where the token-standard-based
--   fee settlement is driven. The user is asked to pay the renewal fee
--   to the provider. Once settled, the old license is archived and a new
--   license with extended validity is created.
template LicenseRenewalRequest
  with
    requestId : Text -- ^ Provider-supplied identifier used to correlate the request with its payment.
    provider : Party -- ^ Party identifying the app provider
    user : Party -- ^ Party identifying the app user
    uuid : Text -- ^ Stable identity of the license being renewed.
    licenseNum : Int -- ^ The license number
    licenseFeeAmount : Decimal -- ^ The amount to be paid for the license renewal
    licenseFeeInstrumentId : InstrumentId -- ^ The instrument used for the license fee payment
    licenseExtensionDuration : RelTime -- ^ The duration for which the license is extended
    settleBefore : Time -- ^ Exclusive deadline for the provider to settle the fee and renew the license.
    requestedAt : Time -- ^ When the settlement was requested
    description : Text -- ^ Reason for renewal
    settlementReference : ContractId RenewalSettlementReference
    originalRequestCid : Optional (ContractId AllocationRequest) -- ^ Set if the wallet signalled acceptance.

  where
    signatory user, provider
    ensure uuid /= "" && licenseFeeAmount > 0.0 && licenseExtensionDuration > seconds 0

    key LicenseRenewalRequestKey with provider; user; requestId : LicenseRenewalRequestKey
    maintainer key.provider

    -- | Completes the renewal by finalizing the token-standard-based fee
    --   transfer via Allocation and creating the new license state.
    --
    --   Once the license fee is transferred, the old license is archived
    --   and replaced with a new license with extended validity.
    postconsuming choice LicenseRenewalRequest_CompleteRenewal : ContractId License
      with
        allocationCid : ContractId Allocation -- ^ Funded by the user.
        allocationFactory : ContractId AllocationFactory -- ^ Authorizes receipt by the provider.
        allocationExtraArgs : ExtraArgs -- ^ Registry context for creating the receipt allocation.
        settlementFactory : ContractId SettlementFactory
        licenseCid : ContractId License
        extraArgs : ExtraArgs -- ^ Registry context for settling both sides.
      controller provider
      do
        assertWithinDeadline "settleBefore" settleBefore

        -- Validate the stable license identity before executing the fee transfer.
        oldLicense <- fetch licenseCid
        uuid === oldLicense.uuid
        licenseNum === oldLicense.licenseNum
        user === oldLicense.user
        provider === oldLicense.provider

        fundedAllocation <- fetch allocationCid
        let allocView = view fundedAllocation
            admin = licenseFeeInstrumentId.admin
        allocView.settlement === renewalSettlement this
        allocView.allocation === senderSpecification this
        require "Instrument admin signed the allocation" (admin `elem` signatory fundedAllocation)

        -- The provider must obtain both CIDs from the instrument's trusted registry.
        -- PublicFetch checks the advertised admin; a factory controls its own response.
        allocationRegistry <- exercise allocationFactory AllocationFactory_PublicFetch with actors = [provider]
        settlementRegistry <- exercise settlementFactory SettlementFactory_PublicFetch with actors = [provider]
        allocationRegistry.admin === admin
        settlementRegistry.admin === admin

        -- V2 settles both sides. The provider authorizes receipt here, with no input holdings.
        now <- getTime
        receipt <- exercise allocationFactory AllocationFactory_Allocate with
          actors = [provider]
          settlement = allocView.settlement
          allocation = receiverSpecification this
          inputHoldingCids = []
          requestedAt = now
          extraArgs = allocationExtraArgs
        receiverCid <- case receipt.output of
          AllocationInstructionResult_Completed cid -> pure cid
          _ -> abort "The provider's receipt allocation must complete immediately"

        result <- exercise settlementFactory SettlementFactory_SettleBatch with
          actors = [provider]
          settlement = allocView.settlement
          transferLegs = [feeTransfer this]
          allocations = [FinalizedAllocation cid [] None | cid <- [allocationCid, receiverCid]]
          extraArgs
        map (.output) result.allocationSettleResults === replicate 2 (AllocationResult_Settled None)

        archive licenseCid
        create oldLicense
          with
            expiresAt = (max now oldLicense.expiresAt) `addRelTime` licenseExtensionDuration

    interface instance AllocationRequest for LicenseRenewalRequest where
      view = AllocationRequestView with
        originalRequestCid
        settlement = renewalSettlement this
        -- Accept is only a signal; the wallet may still need to fund this allocation.
        allocations = [senderSpecification this]
        requestedAt
        settleAt = None -- No scheduled execution time; settlementDeadline carries the cutoff.
        availableActions = Map.fromList $
          [(ARA_Accept, [[user]]) | originalRequestCid == None] <> [(ARA_Reject, [[user]])]
        meta = renewalMetadata this

      allocationRequest_acceptImpl cid arg = do
        arg.actors === [user]
        originalRequestCid === None
        assertWithinDeadline "settleBefore" settleBefore
        archive cid
        -- The signal consumes the wallet request. Keep its terms available for settlement.
        _ <- create this with originalRequestCid = Some cid
        pure (AllocationRequest_AcceptResult emptyMetadata)

      allocationRequest_rejectImpl cid arg = do
        arg.actors === [user]
        archive cid
        pure (AllocationRequest_RejectResult emptyMetadata)

      allocationRequest_withdrawImpl cid arg = do
        arg.actors === [provider]
        archive cid
        pure (AllocationRequest_WithdrawResult emptyMetadata)

      allocationRequest_acceptExtraObservers _ = []
      allocationRequest_rejectExtraObservers _ = []
      allocationRequest_withdrawExtraObservers _ = []

renewalMetadata : LicenseRenewalRequest -> Metadata
renewalMetadata LicenseRenewalRequest{..} = Metadata $ TextMap.fromList
  [ ("splice.lfdecentralizedtrust.org/reason", description)
  , ("cn-quickstart.example.org/licenseNum", show licenseNum)
  , ("cn-quickstart.example.org/uuid", uuid)
  ]

renewalSettlement : LicenseRenewalRequest -> SettlementInfo
renewalSettlement r = SettlementInfo with
  executors = [r.provider]
  id = r.requestId
  cid = Some (coerceContractId r.settlementReference)
  meta = renewalMetadata r

feeTransfer : LicenseRenewalRequest -> TransferLeg
feeTransfer r = TransferLeg with
  transferLegId = licenseFeePaymentLegId
  sender = Account (Some r.user) None ""
  receiver = Account (Some r.provider) None ""
  amount = r.licenseFeeAmount
  instrumentId = r.licenseFeeInstrumentId.id
  meta = renewalMetadata r

senderSpecification, receiverSpecification : LicenseRenewalRequest -> AllocationSpecification
senderSpecification = feeSpecification SenderSide
receiverSpecification = feeSpecification ReceiverSide

feeSpecification : TransferSide -> LicenseRenewalRequest -> AllocationSpecification
feeSpecification side r =
  let leg = feeTransfer r
      (authorizer, otherside) = case side of
        SenderSide -> (leg.sender, leg.receiver)
        ReceiverSide -> (leg.receiver, leg.sender)
  in AllocationSpecification with
    admin = r.licenseFeeInstrumentId.admin
    authorizer
    transferLegSides = [TransferLegSide with
      transferLegId = leg.transferLegId
      side
      otherside
      amount = leg.amount
      instrumentId = leg.instrumentId
      meta = leg.meta]
    settlementDeadline = Some r.settleBefore
    nextIterationFunding = None
    -- As in V1, the user may withdraw the reserved funds before settlement.
    committed = False
    meta = emptyMetadata

licenseFeePaymentLegId : Text
licenseFeePaymentLegId = "licenseFeePayment"
