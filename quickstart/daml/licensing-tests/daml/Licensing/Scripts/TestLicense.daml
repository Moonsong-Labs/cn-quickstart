module Licensing.Scripts.TestLicense where

import Daml.Script

import DA.Assert
import DA.List (sortOn)
import DA.Optional (isNone)
import DA.Time
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationRequestV2
import Splice.Api.Token.AllocationV2
import Splice.Testing.Registries.AmuletRegistryV2 qualified as AmuletRegistry
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClient
import Splice.Testing.Utils

import Licensing.License
import Licensing.AppInstall

--------------------------------------------------------------------------------
-- Shared helpers
--------------------------------------------------------------------------------

{- |
  Common initialization for license renewal tests.

  1. Initialize the Amulet registry with its default configuration.
  2. Allocate the user and provider parties.
  3. Fund the user with 100 Amulet to cover renewal fees.
  4. The user submits an AppInstallRequest and the provider accepts it, creating an AppInstall.
  5. The provider uses the AppInstall to create the user's initial License.
-}
setupLicenseTest
  : () -> Script
      ( (AmuletRegistry.AmuletRegistry, Party, Party)
      , ContractId License
      )
setupLicenseTest () = do
  registry <- AmuletRegistry.initialize AmuletRegistry.defaultAmuletRegistryConfig
  userParty <- allocateParty "user"
  providerParty <- allocateParty "provider"
  _ <- AmuletRegistry.tapFaucet registry userParty 100.0

  installReqCid <- submit userParty $ createCmd AppInstallRequest with
    provider = providerParty
    user = userParty
    meta = emptyMetadata
  installCid <- submit providerParty $
    exerciseCmd installReqCid AppInstallRequest_Accept with
      installMeta = emptyMetadata
      meta = emptyMetadata
  licenseResult <- submit providerParty $
    exerciseCmd installCid AppInstall_CreateLicense with
      uuid = "00000000-0000-4000-8000-000000000010"
      params = LicenseParams with meta = emptyMetadata

  pure ((registry, userParty, providerParty), licenseResult.licenseId)

-- | The provider quotes the fee in the registry's instrument and gives both parties two hours to settle.
initiateLicenseRenewal
  : Text
  -> Decimal
  -> RelTime
  -> (AmuletRegistry.AmuletRegistry, Party)
  -> ContractId License
  -> Text
  -> Script (ContractId LicenseRenewalRequest)
initiateLicenseRenewal description renewalFee extensionDuration (registry, providerParty) licenseCid requestId = do
  now <- getTime
  submit providerParty $ exerciseCmd licenseCid License_Renew with
    requestId
    licenseFeeInstrumentId = registry.instrumentId
    licenseFeeAmount = renewalFee
    licenseExtensionDuration = extensionDuration
    requestedAt = now
    settleBefore = addRelTime now (hours 2)
    description

-- | Use the standard interface query a wallet uses to discover requests visible to its user.
discoverAllocationRequestView
  : Party
  -> ContractId LicenseRenewalRequest
  -> Script AllocationRequestView
discoverAllocationRequestView reader renewalRequestCid = do
  requests <- queryInterface @AllocationRequest reader
  let requestIid = toInterfaceContractId @AllocationRequest renewalRequestCid
      matchingViews = [requestView | (cid, Some requestView) <- requests, cid == requestIid]
  case matchingViews of
    [requestView] -> pure requestView
    _ -> fail "The user's wallet query must discover exactly one matching renewal request"

-- | Reserve the fee using the sender specification published by the request. Settlement happens later.
fundRequest
  : AmuletRegistry.AmuletRegistry
  -> Party
  -> Party
  -> ContractId LicenseRenewalRequest
  -> Script (ContractId Allocation, SettlementInfo)
fundRequest registry userParty providerParty renewalRequestCid = do
  requestData <- discoverAllocationRequestView userParty renewalRequestCid
  requestData.settlement.executors === [providerParty]
  [senderSpec] <- pure requestData.allocations
  senderSpec.authorizer.owner === Some userParty
  allocationCid <- AmuletRegistry.createAllocationForSpecification
    registry userParty requestData.settlement senderSpec
  pure (allocationCid, requestData.settlement)

-- | Only unlocked holdings count toward the amount the user can spend.
unlockedBalance
  : AmuletRegistry.AmuletRegistry
  -> Party
  -> Script Decimal
unlockedBalance registry party = do
  holdings <- WalletClient.listHoldings party registry.instrumentId
  pure $ sum [holding.amount | (_, holding) <- holdings, isNone holding.lock]

-- | Reserving funds reduces the spendable balance while the user still owns the full amount.
assertReserved : AmuletRegistry.AmuletRegistry -> Party -> Party -> Decimal -> Script ()
assertReserved registry userParty providerParty reservedBalance = do
  WalletClient.checkBalance userParty registry.instrumentId 100.0
  WalletClient.checkBalance providerParty registry.instrumentId 0.0
  balance <- unlockedBalance registry userParty
  balance === 100.0 - reservedBalance

-- | Prepare the provider's receipt allocation and batch settlement. The registry supplies the
--   disclosures needed to settle the user's locked holding. Returning the arguments separately
--   lets the failure tests vary one input before submission.
completeWithContexts
  : AmuletRegistry.AmuletRegistry
  -> ContractId License
  -> ContractId Allocation
  -> Script (Disclosures', LicenseRenewalRequest_CompleteRenewal)
completeWithContexts registry licenseCid allocationCid = do
  (allocationFactory, allocationExtraArgs, allocationDisclosures) <-
    AmuletRegistry.getAllocationFactoryContext registry
  (settlementFactory, extraArgs, settlementDisclosures) <-
    AmuletRegistry.getSettlementFactoryContext registry allocationCid
  pure
    ( allocationDisclosures <> settlementDisclosures
    , LicenseRenewalRequest_CompleteRenewal with
        allocationCid
        allocationFactory
        allocationExtraArgs
        settlementFactory
        licenseCid
        extraArgs
    )

-- | Submit as the provider so its receipt, the fee transfer, and the license renewal commit together.
completeRenewalCommand
  : AmuletRegistry.AmuletRegistry
  -> Party
  -> ContractId LicenseRenewalRequest
  -> ContractId License
  -> ContractId Allocation
  -> Script (ContractId License)
completeRenewalCommand registry providerParty renewalRequestCid licenseCid allocationCid = do
  (disclosures, args) <- completeWithContexts registry licenseCid allocationCid
  submitWithDisclosures' providerParty disclosures $
    exerciseCmd renewalRequestCid args

--------------------------------------------------------------------------------
-- Tests
--------------------------------------------------------------------------------

-- | Follow a renewal from AppInstall through wallet funding and provider settlement.
--   Check the balances, the archived request, and the replacement license visible to both parties.
testLicenseTokenStandard : Script ()
testLicenseTokenStandard = script do
  let renewalFee = 20.0
      extension = days 365
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  WalletClient.checkBalance userParty registry.instrumentId 100.0
  Some originalLicense <- queryContractId providerParty licenseCid

  requestCid <- initiateLicenseRenewal
    "Token-standard V2 renewal" renewalFee extension
    (registry, providerParty) licenseCid "req-id-1"
  Some _ <- queryContractId userParty requestCid

  (allocationCid, _) <- fundRequest registry userParty providerParty requestCid
  assertReserved registry userParty providerParty renewalFee
  Some unchangedLicense <- queryContractId providerParty licenseCid
  unchangedLicense.expiresAt === originalLicense.expiresAt
  Some _ <- queryContractId providerParty requestCid

  (disclosures, completeArgs) <-
    completeWithContexts registry licenseCid allocationCid
  submitWithDisclosuresMustFail' userParty disclosures $
    exerciseCmd requestCid completeArgs
  -- A registry error during settlement must also roll back the newly created receipt.
  let incompleteSettlement = completeArgs with extraArgs = emptyExtraArgs
  submitWithDisclosuresMustFail' providerParty disclosures $
    exerciseCmd requestCid incompleteSettlement
  assertReserved registry userParty providerParty renewalFee
  Some _ <- queryContractId userParty licenseCid
  Some _ <- queryContractId providerParty requestCid
  active <- queryInterface @Allocation providerParty
  map fst active === [allocationCid]

  renewedCid <- completeRenewalCommand registry providerParty requestCid licenseCid allocationCid

  WalletClient.checkBalance userParty registry.instrumentId (100.0 - renewalFee)
  WalletClient.checkBalance providerParty registry.instrumentId renewalFee
  [(userLicenseCid, renewedUser)] <- query @License userParty
  userLicenseCid === renewedCid
  query @License providerParty >>= (=== [(renewedCid, renewedUser)])
  query @LicenseRenewalRequest userParty >>= (=== [])
  query @LicenseRenewalRequest providerParty >>= (=== [])
  assertMsg "Renewal must replace the license contract ID" (renewedCid /= licenseCid)
  renewedUser.licenseNum === originalLicense.licenseNum
  renewedUser.uuid === originalLicense.uuid
  now <- getTime
  renewedUser.expiresAt === addRelTime now extension

-- | A funded request belongs to one license UUID, even when another license has the same display number.
testRenewalRejectsDifferentLicenseUuid : Script ()
testRenewalRejectsDifferentLicenseUuid = script do
  let renewalFee = 20.0
      extension = days 30
      otherLicenseUuid = "00000000-0000-4000-8000-000000000011"
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  Some originalLicense <- queryContractId providerParty licenseCid
  otherLicenseCid <- submit [providerParty, userParty] $ createCmd License with
    provider = providerParty
    user = userParty
    expiresAt = originalLicense.expiresAt
    uuid = otherLicenseUuid
    licenseNum = originalLicense.licenseNum
    params = originalLicense.params

  requestCid <- initiateLicenseRenewal
    "UUID mismatch test" renewalFee extension
    (registry, providerParty) licenseCid "req-id-uuid-mismatch"
  (allocationCid, _) <- fundRequest registry userParty providerParty requestCid
  assertReserved registry userParty providerParty renewalFee
  Some _ <- queryContractId providerParty licenseCid

  (disclosures, badArgs) <- completeWithContexts registry otherLicenseCid allocationCid
  submitWithDisclosuresMustFail' providerParty disclosures $
    exerciseCmd requestCid badArgs

  Some _ <- queryContractId providerParty requestCid
  Some _ <- queryContractId providerParty licenseCid
  Some _ <- queryContractId providerParty otherLicenseCid
  assertReserved registry userParty providerParty renewalFee
  renewedCid <- completeRenewalCommand registry providerParty requestCid licenseCid allocationCid

  queryContractId providerParty requestCid >>= (=== None)
  queryContractId providerParty licenseCid >>= (=== None)
  Some _ <- queryContractId providerParty otherLicenseCid
  Some renewedLicense <- queryContractId providerParty renewedCid
  renewedLicense.uuid === originalLicense.uuid
  renewedLicense.licenseNum === originalLicense.licenseNum
  WalletClient.checkBalance userParty registry.instrumentId (100.0 - renewalFee)
  WalletClient.checkBalance providerParty registry.instrumentId renewalFee

-- | The user can reject the proposal before funding. The original license stays active and no fee is paid.
testLicenseTokenStandard_RenewalRejection : Script ()
testLicenseTokenStandard_RenewalRejection = script do
  let renewalFee = 20.0
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  requestCid <- initiateLicenseRenewal
    "Rejected renewal" renewalFee (days 365) (registry, providerParty) licenseCid "req-id-1"
  requestView <- discoverAllocationRequestView userParty requestCid
  [senderSpec] <- pure requestView.allocations
  [feeLeg] <- pure senderSpec.transferLegSides
  feeLeg.side === SenderSide
  feeLeg.instrumentId === registry.instrumentId.id
  feeLeg.amount === renewalFee

  let requestIid = toInterfaceContractId @AllocationRequest requestCid
  submitMustFail providerParty $ exerciseCmd requestIid AllocationRequest_Reject with
    actors = [providerParty]
    extraArgs = emptyExtraArgs
  submit userParty $ exerciseCmd requestIid AllocationRequest_Reject with
    actors = [userParty]
    extraArgs = emptyExtraArgs
  queryContractId providerParty requestCid >>= (=== None)
  Some _ <- queryContractId providerParty licenseCid
  WalletClient.checkBalance userParty registry.instrumentId 100.0
  WalletClient.checkBalance providerParty registry.instrumentId 0.0

-- | An expired license receives its full extension starting at settlement time.
testLicenseTokenStandard_ExpiredLicenseRenewal : Script ()
testLicenseTokenStandard_ExpiredLicenseRenewal = script do
  let extension = days 365
      renewalFee = 20.0
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  passTime extension
  Some oldLicense <- queryContractId userParty licenseCid
  now <- getTime
  assertMsg "Expiry was in the past" (oldLicense.expiresAt < now)

  requestCid <- initiateLicenseRenewal
    "Renewal for expired license" renewalFee extension
    (registry, providerParty) licenseCid "req-id-expired"
  (allocationCid, _) <- fundRequest registry userParty providerParty requestCid
  renewalTime <- getTime
  renewedCid <- completeRenewalCommand registry providerParty requestCid licenseCid allocationCid

  [(userLicenseCid, renewed)] <- query @License userParty
  userLicenseCid === renewedCid
  query @License providerParty >>= (=== [(renewedCid, renewed)])
  renewed.expiresAt === addRelTime renewalTime extension
  WalletClient.checkBalance userParty registry.instrumentId (100.0 - renewalFee)
  WalletClient.checkBalance providerParty registry.instrumentId renewalFee

-- | Two requests can be outstanding for the same license. Each has its own allocation,
--   and their extensions accumulate as the provider settles them in sequence.
testLicenseTokenStandard_ConcurrentRenewals : Script ()
testLicenseTokenStandard_ConcurrentRenewals = script do
  let renewalFee = 10.0
      extension = days 10
  ((registry, userParty, providerParty), originalCid) <- setupLicenseTest ()
  Some original <- queryContractId providerParty originalCid
  firstRequest <- initiateLicenseRenewal
    "First concurrent renewal" renewalFee extension
    (registry, providerParty) originalCid "req-id-1"
  secondRequest <- initiateLicenseRenewal
    "Second concurrent renewal" renewalFee extension
    (registry, providerParty) originalCid "req-id-2"

  visibleRequests <- queryInterface @AllocationRequest userParty
  let expectedRequests = map (toInterfaceContractId @AllocationRequest) [firstRequest, secondRequest]
  sortOn show (map fst visibleRequests) === sortOn show expectedRequests

  (firstAllocation, _) <- fundRequest registry userParty providerParty firstRequest
  (secondAllocation, _) <- fundRequest registry userParty providerParty secondRequest
  assertReserved registry userParty providerParty (renewalFee + renewalFee)
  Some _ <- queryContractId providerParty originalCid

  (disclosures, wrongAllocationArgs) <-
    completeWithContexts registry originalCid secondAllocation
  submitWithDisclosuresMustFail' providerParty disclosures $
    exerciseCmd firstRequest wrongAllocationArgs
  Some _ <- queryContractId providerParty firstRequest
  Some _ <- queryContractId providerParty originalCid

  renewalTime <- getTime
  firstRenewedCid <- completeRenewalCommand registry providerParty firstRequest originalCid firstAllocation
  [firstRenewed] <- query @License userParty
  firstRenewed._1 === firstRenewedCid
  firstRenewed._2.expiresAt === addRelTime renewalTime extension
  -- The first renewal archived originalCid. Settle the second request against the active license.
  secondRenewedCid <- completeRenewalCommand registry providerParty secondRequest firstRenewedCid secondAllocation
  [secondRenewed] <- query @License userParty
  secondRenewed._1 === secondRenewedCid
  secondRenewed._2.expiresAt === addRelTime renewalTime (extension + extension)
  secondRenewed._2.licenseNum === original.licenseNum
  secondRenewed._2.uuid === original.uuid
  WalletClient.checkBalance userParty registry.instrumentId (100.0 - renewalFee - renewalFee)
  WalletClient.checkBalance providerParty registry.instrumentId (renewalFee + renewalFee)

-- | At the exact deadline, even a funded request cannot settle. The user can withdraw the reserved fee.
testRenewalCannotSettleAtOrAfterDeadline : Script ()
testRenewalCannotSettleAtOrAfterDeadline = script do
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  requestCid <- initiateLicenseRenewal
    "Expired settlement" 20.0 (days 30) (registry, providerParty) licenseCid "expired-settlement"
  (allocationCid, _) <- fundRequest registry userParty providerParty requestCid
  assertReserved registry userParty providerParty 20.0
  Some request <- queryContractId providerParty requestCid
  passTime (hours 2)
  now <- getTime
  now === request.settleBefore

  submitMustFail userParty $ exerciseCmd (toInterfaceContractId @AllocationRequest requestCid)
    AllocationRequest_Accept with actors = [userParty]; extraArgs = emptyExtraArgs
  (disclosures, args) <- completeWithContexts registry licenseCid allocationCid
  submitWithDisclosuresMustFail' providerParty disclosures $
    exerciseCmd requestCid args
  Some _ <- queryContractId providerParty requestCid
  Some _ <- queryContractId providerParty licenseCid
  activeAllocations <- queryInterface @Allocation providerParty
  assertMsg "The user's allocation remains active after the settlement deadline"
    (allocationCid `elem` map fst activeAllocations)
  WalletClient.checkBalance userParty registry.instrumentId 100.0
  WalletClient.checkBalance providerParty registry.instrumentId 0.0

  recovered <- submit userParty $ exerciseCmd allocationCid Allocation_Withdraw with
    actors = [userParty]
    extraArgs = emptyExtraArgs
  recovered.output === AllocationResult_Withdrawn
  unlockedBalance registry userParty >>= (=== 100.0)

-- | A wallet may signal acceptance before funding. It must still be able to discover and
--   fund the replacement request, with the original settlement terms, just before the deadline.
testAllocationRequestAcceptSignalIsOptional : Script ()
testAllocationRequestAcceptSignalIsOptional = script do
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  requestCid <- initiateLicenseRenewal
    "Optional acceptance signal" 20.0 (days 30) (registry, providerParty) licenseCid "signal"
  Some terms <- queryContractId userParty requestCid
  requestData <- discoverAllocationRequestView userParty requestCid
  [spec] <- pure requestData.allocations
  spec.settlementDeadline === Some terms.settleBefore
  requestData.settleAt === None
  setTime (terms.settleBefore `addRelTime` seconds (-1))
  let requestIid = toInterfaceContractId @AllocationRequest requestCid
  submitMustFail providerParty $ exerciseCmd requestIid AllocationRequest_Accept with
    actors = [providerParty]
    extraArgs = emptyExtraArgs
  submit userParty $ exerciseCmd requestIid AllocationRequest_Accept with
    actors = [userParty]
    extraArgs = emptyExtraArgs

  [(replacementCid, replacement)] <- queryAllByKey @LicenseRenewalRequest providerParty
    (LicenseRenewalRequestKey providerParty userParty "signal")
  let replacementView = view $ toInterface @AllocationRequest replacement
  replacementView.originalRequestCid === Some requestIid
  replacementView.settlement === requestData.settlement
  replacementView.allocations === [spec]
  (allocationCid, _) <- fundRequest registry userParty providerParty replacementCid
  assertReserved registry userParty providerParty 20.0

  _ <- completeRenewalCommand registry providerParty replacementCid licenseCid allocationCid
  queryContractId providerParty replacementCid >>= (=== None)

-- | A provider can reuse a request ID and identical terms. A reservation for the rejected
--   request must never pay for its replacement.
testRepeatedRequestIdGetsUniqueSettlement : Script ()
testRepeatedRequestIdGetsUniqueSettlement = script do
  ((registry, userParty, providerParty), licenseCid) <- setupLicenseTest ()
  firstRequest <- initiateLicenseRenewal
    "Same request terms" 20.0 (days 30) (registry, providerParty) licenseCid "reused"
  (firstAllocation, firstSettlement) <- fundRequest registry userParty providerParty firstRequest
  let firstIid = toInterfaceContractId @AllocationRequest firstRequest
  submit userParty $ exerciseCmd firstIid AllocationRequest_Reject with
    actors = [userParty]
    extraArgs = emptyExtraArgs

  secondRequest <- initiateLicenseRenewal
    "Same request terms" 20.0 (days 30) (registry, providerParty) licenseCid "reused"
  (secondAllocation, secondSettlement) <- fundRequest registry userParty providerParty secondRequest
  assertMsg "Each request must have a distinct settlement contract ID"
    (firstSettlement.cid /= secondSettlement.cid)
  firstSettlement.id === secondSettlement.id

  (disclosures, staleAllocationArgs) <-
    completeWithContexts registry licenseCid firstAllocation
  submitWithDisclosuresMustFail' providerParty disclosures $
    exerciseCmd secondRequest staleAllocationArgs
  Some _ <- queryContractId providerParty secondRequest
  Some _ <- queryContractId providerParty licenseCid
  activeAllocations <- queryInterface @Allocation userParty
  assertMsg "The stale allocation remains reserved for its original settlement"
    (firstAllocation `elem` map fst activeAllocations)

  _ <- completeRenewalCommand registry providerParty secondRequest licenseCid secondAllocation
  WalletClient.checkBalance userParty registry.instrumentId 80.0
  WalletClient.checkBalance providerParty registry.instrumentId 20.0
